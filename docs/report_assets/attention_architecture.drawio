                <mxCell id="host" value="Host CPU + XRT&lt;br&gt;&lt;br&gt;Build Q/K/V tiles&lt;br&gt;Allocate BOs&lt;br&gt;DMA sync&lt;br&gt;Launch kernels&lt;br&gt;Assemble rows&lt;br&gt;Verify numeric outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="310" y="115" width="240" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="hbm" value="HBM Bank Mapping&lt;br&gt;&lt;br&gt;0: Q tile&lt;br&gt;1: K tile&lt;br&gt;2: unused in fused path&lt;br&gt;3: scaled score tile&lt;br&gt;4: tile probs / row logits&lt;br&gt;5: full-row weights&lt;br&gt;6: V tile&lt;br&gt;7: V partial output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="600" y="95" width="295" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="k1" value="Kernel 1&lt;br&gt;score_mask_scale&lt;br&gt;&lt;br&gt;Input tile:&lt;br&gt;Q 8 x 64 INT8&lt;br&gt;K 64 x 64 INT8&lt;br&gt;&lt;br&gt;Computes QK, applies causal mask, scales to FP32 logits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="40" y="400" width="300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="assemble" value="Host Row Assembly&lt;br&gt;&lt;br&gt;For each Q chunk, collect all K chunks into one 8 x S logit block.&lt;br&gt;&lt;br&gt;Required because softmax must normalize across all keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="390" y="400" width="300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="k2" value="Kernel 2&lt;br&gt;softmax_full_row&lt;br&gt;&lt;br&gt;Input: 8 x S logits&lt;br&gt;S &lt;= 512&lt;br&gt;&lt;br&gt;Output: 8 x S attention weights&lt;br&gt;each row sums to 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="740" y="400" width="300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="k3" value="Kernel 3&lt;br&gt;v_weighted_sum&lt;br&gt;&lt;br&gt;weights tile: 8 x 64 FP32&lt;br&gt;V tile: 64 x 64 FP32&lt;br&gt;&lt;br&gt;Produces partial 8 x 64 attention output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="400" width="300" height="170" as="geometry"/>
