                <mxCell id="title" value="U55C One-Head Attention Pipeline&lt;br&gt;Fused score + mask/scale, full-row softmax, and softmax @ V" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;" parent="1" vertex="1">
