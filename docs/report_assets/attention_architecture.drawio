    <diagram id="attention-arch" name="Frozen Master Architecture">
        <mxGraphModel dx="1674" dy="779" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
