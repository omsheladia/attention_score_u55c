<mxfile host="app.diagrams.net" modified="2026-05-03T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="attention-arch" name="Current Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Current U55C One-Head Attention Pipeline&lt;br&gt;Q/K score, mask+scale, full-row softmax, and softmax @ V" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1780" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="source" value="Input Source&lt;br&gt;&lt;br&gt;Synthetic --seq-len S&lt;br&gt;or saved --vectors dir&lt;br&gt;&lt;br&gt;Q_rot_int8, K_rot_int8&lt;br&gt;V_fp32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="host" value="Host CPU + XRT&lt;br&gt;&lt;br&gt;Build tiles&lt;br&gt;Allocate BOs&lt;br&gt;DMA sync&lt;br&gt;Launch kernels&lt;br&gt;Verify numeric outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="310" y="110" width="220" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="hbm" value="HBM Bank Mapping&lt;br&gt;&lt;br&gt;0: Q tile&lt;br&gt;1: K tile&lt;br&gt;2: raw score tile&lt;br&gt;3: scaled score tile&lt;br&gt;4: tile probs / row logits&lt;br&gt;5: full-row weights&lt;br&gt;6: V tile&lt;br&gt;7: V partial output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="280" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="k1" value="Kernel 1&lt;br&gt;attention_score&lt;br&gt;&lt;br&gt;Q tile: 8 x 64 INT8&lt;br&gt;K tile: 64 x 64 INT8&lt;br&gt;&lt;br&gt;Output: 8 x 64 INT32 raw scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="250" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="k2" value="Kernel 2&lt;br&gt;mask_scale&lt;br&gt;&lt;br&gt;Apply causal mask&lt;br&gt;Scale by q_scale * k_scale / 8&lt;br&gt;&lt;br&gt;Output: 8 x 64 FP32 logits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="250" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="assemble" value="Host Row Assembly&lt;br&gt;&lt;br&gt;For each Q chunk, collect all K chunks into one 8 x S row-logit block.&lt;br&gt;&lt;br&gt;This is required before softmax for S &gt; 64." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="640" y="390" width="260" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="k3" value="Kernel 3&lt;br&gt;softmax_full_row&lt;br&gt;&lt;br&gt;Input: 8 x S logits&lt;br&gt;S &lt;= 512&lt;br&gt;&lt;br&gt;Output: 8 x S attention weights&lt;br&gt;rows sum to 1 across all keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="950" y="390" width="260" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="k4" value="Kernel 4&lt;br&gt;v_weighted_sum&lt;br&gt;&lt;br&gt;weights tile: 8 x 64 FP32&lt;br&gt;V tile: 64 x 64 FP32&lt;br&gt;&lt;br&gt;Host accumulates K/V chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1260" y="390" width="260" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="output" value="Final Output&lt;br&gt;&lt;br&gt;attn_out_fp32&lt;br&gt;shape: S x 64&lt;br&gt;&lt;br&gt;This is one attention head, not tokens or text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1570" y="390" width="250" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="legacy" value="Legacy Single-Tile Path&lt;br&gt;&lt;br&gt;Fixed 8 x 64 vector tests still use softmax_u55c_kernel.&lt;br&gt;Tiled runs use softmax_full_row." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="340" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="tiling" value="Tiling Model&lt;br&gt;&lt;br&gt;Q chunks = ceil(S / 8)&lt;br&gt;K/V chunks = ceil(S / 64)&lt;br&gt;tiles per head = Q chunks * K chunks&lt;br&gt;&lt;br&gt;Verified synthetic S = 8, 64, 128, 256, 512&lt;br&gt;Verified real-vector S = 16, 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="650" width="390" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="verify" value="Verification&lt;br&gt;&lt;br&gt;No token is expected from this block.&lt;br&gt;Host compares numeric tensors:&lt;br&gt;raw scores, scaled logits, softmax weights, and attn_out.&lt;br&gt;&lt;br&gt;Typical float tolerance: 1e-4&lt;br&gt;PyTorch full-float real reference: 1e-3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="850" y="650" width="410" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="scope" value="Scope Boundary&lt;br&gt;&lt;br&gt;Implemented: isolated one-head attention block from Q_rot/K_rot/V to attn_out.&lt;br&gt;&lt;br&gt;Out of scope: Q/K/V projection GEMMs, RoPE generation, decoder integration, full TinyLlama tokens/sec." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1300" y="650" width="480" height="170" as="geometry"/>
        </mxCell>

